<Project DefaultTargets="Verify">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <DotNetRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</DotNetRoot>
    <PackageProject>$(DotNetRoot)/KairosBoot/KairosBoot.csproj</PackageProject>
    <TestRoot>$(MSBuildThisFileDirectory)obj/native-pack-contract</TestRoot>
    <ManagedOutput>$(TestRoot)/managed</ManagedOutput>
    <ManagedExtract>$(TestRoot)/managed-extract</ManagedExtract>
    <MissingOutput>$(TestRoot)/missing</MissingOutput>
    <CompleteRuntimeRoot>$(TestRoot)/complete-runtimes</CompleteRuntimeRoot>
    <CompleteOutput>$(TestRoot)/complete</CompleteOutput>
    <CompleteExtract>$(TestRoot)/complete-extract</CompleteExtract>
    <ManagedVersion>9.8.7-managedtest</ManagedVersion>
    <MissingVersion>9.8.7-missingtest</MissingVersion>
    <CompleteVersion>9.8.7-nativepacktest</CompleteVersion>
    <ManagedPackage>$(ManagedOutput)/KairosBoot.$(ManagedVersion).nupkg</ManagedPackage>
    <MissingPackage>$(MissingOutput)/KairosBoot.$(MissingVersion).nupkg</MissingPackage>
    <CompletePackage>$(CompleteOutput)/KairosBoot.$(CompleteVersion).nupkg</CompletePackage>
    <DotNetHostPath Condition="'$(DotNetHostPath)' == ''">dotnet</DotNetHostPath>
  </PropertyGroup>

  <Target Name="Prepare">
    <RemoveDir Directories="$(TestRoot)" />
    <MakeDir Directories="$(ManagedOutput);$(MissingOutput);$(CompleteOutput)" />

    <ItemGroup>
      <_PlaceholderAsset Include="$(CompleteRuntimeRoot)/win-x64/native/kairosboot.dll" />
      <_PlaceholderAsset Include="$(CompleteRuntimeRoot)/win-arm64/native/kairosboot.dll" />
      <_PlaceholderAsset Include="$(CompleteRuntimeRoot)/linux-x64/native/libkairosboot.so" />
      <_PlaceholderAsset Include="$(CompleteRuntimeRoot)/linux-arm64/native/libkairosboot.so" />
      <_PlaceholderAsset Include="$(CompleteRuntimeRoot)/osx-x64/native/libkairosboot.dylib" />
      <_PlaceholderAsset Include="$(CompleteRuntimeRoot)/osx-arm64/native/libkairosboot.dylib" />
      <_PlaceholderAsset Include="$(CompleteRuntimeRoot)/win-x64/native/licenses/NOTICE.txt" />
    </ItemGroup>

    <MakeDir Directories="@(_PlaceholderAsset->'%(RootDir)%(Directory)')" />
    <WriteLinesToFile File="%(_PlaceholderAsset.Identity)"
                      Lines="KairosBoot native pack contract placeholder"
                      Overwrite="true" />
  </Target>

  <Target Name="BuildManaged" DependsOnTargets="Prepare">
    <MSBuild Projects="$(PackageProject)"
             Targets="Build"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="VerifyManagedOnly" DependsOnTargets="BuildManaged">
    <MSBuild Projects="$(PackageProject)"
             Targets="Pack"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);NoBuild=true;IncludeNativeRuntimes=false;NativeRuntimeRoot=$(TestRoot)/absent;PackageVersion=$(ManagedVersion);PackageOutputPath=$(ManagedOutput)" />

    <Error Condition="!Exists('$(ManagedPackage)')"
           Text="Managed-only package was not created at $(ManagedPackage)." />
    <Unzip SourceFiles="$(ManagedPackage)"
           DestinationFolder="$(ManagedExtract)"
           OverwriteReadOnlyFiles="true" />
    <Error Condition="Exists('$(ManagedExtract)/runtimes')"
           Text="Managed-only package unexpectedly contains native runtime assets." />
  </Target>

  <Target Name="VerifyMissingRuntimeFailure" DependsOnTargets="VerifyManagedOnly">
    <!-- A failed MSBuild task marks the outer build unsuccessful even when its
         error is expected. Run this negative case as a child process instead. -->
    <Exec Command="&quot;$(DotNetHostPath)&quot; msbuild &quot;$(PackageProject)&quot; /nologo /m:1 /t:Pack /p:Configuration=&quot;$(Configuration)&quot; /p:NoBuild=true /p:IncludeNativeRuntimes=true /p:NativeRuntimeRoot=&quot;$(TestRoot)/absent&quot; /p:PackageVersion=$(MissingVersion) /p:PackageOutputPath=&quot;$(MissingOutput)&quot;"
          IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="Low"
          StandardErrorImportance="Low">
      <Output TaskParameter="ExitCode" PropertyName="MissingPackExitCode" />
    </Exec>
    <Error Condition="'$(MissingPackExitCode)' == ''"
           Text="Missing-runtime pack child process did not report an exit code." />
    <Error Condition="'$(MissingPackExitCode)' == '0'"
           Text="Native runtime pack unexpectedly succeeded with all RID files missing." />
    <Error Condition="Exists('$(MissingPackage)')"
           Text="Native runtime validation ran too late; an invalid package was created." />
    <Message Importance="High"
             Text="Missing-runtime pack failed as expected with exit code $(MissingPackExitCode); no invalid package was created." />
  </Target>

  <Target Name="VerifyCompleteRuntimeLayout" DependsOnTargets="VerifyMissingRuntimeFailure">
    <MSBuild Projects="$(PackageProject)"
             Targets="Pack"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);NoBuild=true;IncludeNativeRuntimes=true;NativeRuntimeRoot=$(CompleteRuntimeRoot);PackageVersion=$(CompleteVersion);PackageOutputPath=$(CompleteOutput)" />

    <Error Condition="!Exists('$(CompletePackage)')"
           Text="Complete native package was not created at $(CompletePackage)." />
    <Unzip SourceFiles="$(CompletePackage)"
           DestinationFolder="$(CompleteExtract)"
           OverwriteReadOnlyFiles="true" />

    <ItemGroup>
      <_ExpectedPackageAsset Include="$(CompleteExtract)/runtimes/win-x64/native/kairosboot.dll" />
      <_ExpectedPackageAsset Include="$(CompleteExtract)/runtimes/win-arm64/native/kairosboot.dll" />
      <_ExpectedPackageAsset Include="$(CompleteExtract)/runtimes/linux-x64/native/libkairosboot.so" />
      <_ExpectedPackageAsset Include="$(CompleteExtract)/runtimes/linux-arm64/native/libkairosboot.so" />
      <_ExpectedPackageAsset Include="$(CompleteExtract)/runtimes/osx-x64/native/libkairosboot.dylib" />
      <_ExpectedPackageAsset Include="$(CompleteExtract)/runtimes/osx-arm64/native/libkairosboot.dylib" />
      <_ExpectedPackageAsset Include="$(CompleteExtract)/runtimes/win-x64/native/licenses/NOTICE.txt" />
    </ItemGroup>

    <Error Condition="!Exists('%(_ExpectedPackageAsset.Identity)')"
           Text="Native package is missing: %(_ExpectedPackageAsset.Identity)" />
  </Target>

  <Target Name="Verify"
          DependsOnTargets="VerifyCompleteRuntimeLayout"
          Returns="$(CompletePackage)" />
</Project>
