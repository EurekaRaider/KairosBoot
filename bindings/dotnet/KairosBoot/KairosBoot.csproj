<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>KairosBoot</PackageId>
    <Version>0.1.0-dev</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <Authors>EurekaRaider</Authors>
    <Description>C# bindings for the cross-platform KairosBoot Fastboot host SDK.</Description>
    <PackageTags>android;fastboot;usb;flashing;interop</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/EurekaRaider/KairosBoot</PackageProjectUrl>
    <RepositoryUrl>https://github.com/EurekaRaider/KairosBoot</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <IncludeNativeRuntimes Condition="'$(IncludeNativeRuntimes)' == ''">false</IncludeNativeRuntimes>
    <NativeRuntimeRoot Condition="'$(NativeRuntimeRoot)' == ''">$(MSBuildProjectDirectory)/runtimes</NativeRuntimeRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies"
                      Version="1.0.3"
                      PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup Condition="'$(IncludeNativeRuntimes)' == 'true'">
    <None Remove="$(NativeRuntimeRoot)/**/*" />
    <None Include="$(NativeRuntimeRoot)/win-x64/native/**/*"
          Exclude="$(NativeRuntimeRoot)/win-x64/native/licenses/**/*"
          Pack="true"
          PackagePath="runtimes/win-x64/native/" />
    <None Include="$(NativeRuntimeRoot)/win-arm64/native/**/*"
          Exclude="$(NativeRuntimeRoot)/win-arm64/native/licenses/**/*"
          Pack="true"
          PackagePath="runtimes/win-arm64/native/" />
    <None Include="$(NativeRuntimeRoot)/linux-x64/native/**/*"
          Exclude="$(NativeRuntimeRoot)/linux-x64/native/licenses/**/*"
          Pack="true"
          PackagePath="runtimes/linux-x64/native/" />
    <None Include="$(NativeRuntimeRoot)/linux-arm64/native/**/*"
          Exclude="$(NativeRuntimeRoot)/linux-arm64/native/licenses/**/*"
          Pack="true"
          PackagePath="runtimes/linux-arm64/native/" />
    <None Include="$(NativeRuntimeRoot)/osx-x64/native/**/*"
          Exclude="$(NativeRuntimeRoot)/osx-x64/native/licenses/**/*"
          Pack="true"
          PackagePath="runtimes/osx-x64/native/" />
    <None Include="$(NativeRuntimeRoot)/osx-arm64/native/**/*"
          Exclude="$(NativeRuntimeRoot)/osx-arm64/native/licenses/**/*"
          Pack="true"
          PackagePath="runtimes/osx-arm64/native/" />

    <None Include="$(NativeRuntimeRoot)/win-x64/native/licenses/libusb/COPYING"
          Pack="true"
          PackagePath="licenses/libusb/" />
    <None Include="$(NativeRuntimeRoot)/win-x64/native/licenses/libusb/kairosboot-libusb.json"
          Pack="true"
          PackagePath="licenses/libusb/manifests/win-x64.json" />
    <None Include="$(NativeRuntimeRoot)/win-arm64/native/licenses/libusb/kairosboot-libusb.json"
          Pack="true"
          PackagePath="licenses/libusb/manifests/win-arm64.json" />
    <None Include="$(NativeRuntimeRoot)/linux-x64/native/licenses/libusb/kairosboot-libusb.json"
          Pack="true"
          PackagePath="licenses/libusb/manifests/linux-x64.json" />
    <None Include="$(NativeRuntimeRoot)/linux-arm64/native/licenses/libusb/kairosboot-libusb.json"
          Pack="true"
          PackagePath="licenses/libusb/manifests/linux-arm64.json" />
    <None Include="$(NativeRuntimeRoot)/osx-x64/native/licenses/libusb/kairosboot-libusb.json"
          Pack="true"
          PackagePath="licenses/libusb/manifests/osx-x64.json" />
    <None Include="$(NativeRuntimeRoot)/osx-arm64/native/licenses/libusb/kairosboot-libusb.json"
          Pack="true"
          PackagePath="licenses/libusb/manifests/osx-arm64.json" />
    <None Include="$(NativeRuntimeRoot)/win-x64/native/licenses/boost/LICENSE_1_0.txt"
          Pack="true"
          PackagePath="licenses/boost/LICENSE_1_0.txt" />
    <None Include="$(NativeRuntimeRoot)/win-x64/native/licenses/miniz/LICENSE"
          Pack="true"
          PackagePath="licenses/miniz/" />

    <None Include="build/net48/KairosBoot.targets"
          Pack="true"
          PackagePath="build/net48/" />
    <None Include="buildTransitive/net48/KairosBoot.targets"
          Pack="true"
          PackagePath="buildTransitive/net48/" />
    <None Include="licenses/microsoft-vc-runtime/NOTICE.txt"
          Pack="true"
          PackagePath="licenses/microsoft-vc-runtime/NOTICE.txt" />
  </ItemGroup>

  <Target Name="ValidateNativeRuntimeAssets"
          BeforeTargets="_IntermediatePack"
          Condition="'$(IncludeNativeRuntimes)' == 'true'">
    <ItemGroup>
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/win-x64/native/kairosboot_native.dll" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/win-x64/native/libusb-1.0.dll" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/win-x64/native/msvcp140.dll" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/win-x64/native/msvcp140_1.dll" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/win-x64/native/msvcp140_2.dll" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/win-x64/native/msvcp140_atomic_wait.dll" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/win-x64/native/vcruntime140.dll" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/win-x64/native/vcruntime140_1.dll" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/win-arm64/native/kairosboot_native.dll" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/win-arm64/native/libusb-1.0.dll" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/win-arm64/native/msvcp140.dll" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/win-arm64/native/msvcp140_1.dll" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/win-arm64/native/msvcp140_2.dll" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/win-arm64/native/msvcp140_atomic_wait.dll" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/win-arm64/native/vcruntime140.dll" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/win-arm64/native/vcruntime140_1.dll" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/linux-x64/native/libkairosboot_native.so" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/linux-x64/native/libusb-1.0.so.0" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/linux-arm64/native/libkairosboot_native.so" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/linux-arm64/native/libusb-1.0.so.0" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/osx-x64/native/libkairosboot_native.dylib" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/osx-x64/native/libusb-1.0.0.dylib" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/osx-arm64/native/libkairosboot_native.dylib" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/osx-arm64/native/libusb-1.0.0.dylib" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/win-x64/native/licenses/libusb/COPYING" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/win-arm64/native/licenses/libusb/COPYING" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/linux-x64/native/licenses/libusb/COPYING" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/linux-arm64/native/licenses/libusb/COPYING" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/osx-x64/native/licenses/libusb/COPYING" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/osx-arm64/native/licenses/libusb/COPYING" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/win-x64/native/licenses/libusb/kairosboot-libusb.json" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/win-arm64/native/licenses/libusb/kairosboot-libusb.json" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/linux-x64/native/licenses/libusb/kairosboot-libusb.json" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/linux-arm64/native/licenses/libusb/kairosboot-libusb.json" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/osx-x64/native/licenses/libusb/kairosboot-libusb.json" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/osx-arm64/native/licenses/libusb/kairosboot-libusb.json" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/win-x64/native/licenses/boost/LICENSE_1_0.txt" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/win-arm64/native/licenses/boost/LICENSE_1_0.txt" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/linux-x64/native/licenses/boost/LICENSE_1_0.txt" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/linux-arm64/native/licenses/boost/LICENSE_1_0.txt" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/osx-x64/native/licenses/boost/LICENSE_1_0.txt" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/osx-arm64/native/licenses/boost/LICENSE_1_0.txt" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/win-x64/native/licenses/miniz/LICENSE" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/win-arm64/native/licenses/miniz/LICENSE" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/linux-x64/native/licenses/miniz/LICENSE" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/linux-arm64/native/licenses/miniz/LICENSE" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/osx-x64/native/licenses/miniz/LICENSE" />
      <_ExpectedNativeAsset Include="$(NativeRuntimeRoot)/osx-arm64/native/licenses/miniz/LICENSE" />
      <_MissingNativeAsset Include="@(_ExpectedNativeAsset)"
                           Condition="!Exists('%(Identity)')" />
    </ItemGroup>

    <Error Condition="'@(_MissingNativeAsset)' != ''"
           Text="IncludeNativeRuntimes=true requires complete six-RID native, libusb, Boost, miniz, app-local VC runtime, and redistribution assets. Missing: @(_MissingNativeAsset, ', ')" />
  </Target>
</Project>
