{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairosboot.io/schemas/benchmark-result.v1.schema.json",
  "title": "KairosBoot Benchmark Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environment", "rawBulkCeilingBytesPerSecond", "scenarios"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "environment": {
      "type": "object",
      "required": ["hostOs", "hostArch", "usbController", "device", "fastbootVersion", "kairosbootVersion"],
      "properties": {
        "hostOs": { "type": "string" },
        "hostArch": { "type": "string" },
        "usbController": { "type": "string" },
        "device": { "type": "string" },
        "fastbootVersion": { "type": "string" },
        "kairosbootVersion": { "type": "string" }
      }
    },
    "rawBulkCeilingBytesPerSecond": { "type": "number", "exclusiveMinimum": 0 },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "sampleCount", "kairosbootMedianBytesPerSecond", "fastbootMedianBytesPerSecond", "ceilingUtilization", "relativeDelta"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sampleCount": { "type": "integer", "minimum": 5 },
          "kairosbootMedianBytesPerSecond": { "type": "number", "minimum": 0 },
          "fastbootMedianBytesPerSecond": { "type": "number", "minimum": 0 },
          "ceilingUtilization": { "type": "number", "minimum": 0, "maximum": 1.1 },
          "relativeDelta": { "type": "number" },
          "pValue": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
