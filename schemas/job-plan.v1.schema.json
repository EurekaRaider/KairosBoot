{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairosboot.io/schemas/job-plan.v1.schema.json",
  "title": "KairosBoot JobPlan v1",
  "$comment": "JobPlan is an immutable, canonical, device-independent plan. It intentionally contains no job identifier or timestamps, so identical manifest bytes produce identical JSON.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestApiVersion",
    "kind",
    "manifestSha256",
    "artifacts",
    "targets",
    "policy"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "manifestApiVersion": { "const": "kairosboot.io/v1" },
    "kind": { "const": "FlashJob" },
    "manifestSha256": { "$ref": "#/$defs/sha256" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16384,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/target" }
    },
    "policy": { "$ref": "#/$defs/policy" }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 256 },
    "nonEmpty": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serials", "usbPaths"],
      "anyOf": [
        { "properties": { "serials": { "minItems": 1 } } },
        { "properties": { "usbPaths": { "minItems": 1 } } }
      ],
      "properties": {
        "serials": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "usbPaths": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "id", "path", "sha256"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "id": { "$ref": "#/$defs/identifier" },
        "path": { "$ref": "#/$defs/nonEmpty" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "operation",
        "partition",
        "artifact",
        "slot",
        "rebootTarget",
        "oemCommand"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "operation": {
          "type": "string",
          "enum": ["flash", "erase", "set_active", "reboot", "oem"]
        },
        "partition": { "type": ["string", "null"], "minLength": 1, "maxLength": 4096 },
        "artifact": { "type": ["string", "null"], "minLength": 1, "maxLength": 4096 },
        "slot": { "enum": [null, "current", "other", "all", "a", "b"] },
        "rebootTarget": { "enum": [null, "system", "bootloader", "recovery", "fastboot"] },
        "oemCommand": { "type": ["string", "null"], "minLength": 1, "maxLength": 4096 }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "flash" } }, "required": ["operation"] },
          "then": {
            "properties": {
              "partition": { "type": "string" },
              "artifact": { "type": "string" },
              "rebootTarget": { "type": "null" },
              "oemCommand": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "erase" } }, "required": ["operation"] },
          "then": {
            "properties": {
              "partition": { "type": "string" },
              "artifact": { "type": "null" },
              "slot": { "type": "null" },
              "rebootTarget": { "type": "null" },
              "oemCommand": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "set_active" } }, "required": ["operation"] },
          "then": {
            "properties": {
              "partition": { "type": "null" },
              "artifact": { "type": "null" },
              "slot": { "enum": ["other", "a", "b"] },
              "rebootTarget": { "type": "null" },
              "oemCommand": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "reboot" } }, "required": ["operation"] },
          "then": {
            "properties": {
              "partition": { "type": "null" },
              "artifact": { "type": "null" },
              "slot": { "type": "null" },
              "rebootTarget": { "enum": ["system", "bootloader", "recovery", "fastboot"] },
              "oemCommand": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "oem" } }, "required": ["operation"] },
          "then": {
            "properties": {
              "partition": { "type": "null" },
              "artifact": { "type": "null" },
              "slot": { "type": "null" },
              "rebootTarget": { "type": "null" },
              "oemCommand": { "type": "string" }
            }
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "name", "selector", "expectedProduct", "steps"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "name": { "$ref": "#/$defs/identifier" },
        "selector": { "$ref": "#/$defs/selector" },
        "expectedProduct": { "$ref": "#/$defs/nonEmpty" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16384,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["onDeviceFailure", "maxParallelDevices", "memoryBudget"],
      "properties": {
        "onDeviceFailure": { "type": "string", "enum": ["continue", "stop"] },
        "maxParallelDevices": { "type": "integer", "minimum": 1, "maximum": 256 },
        "memoryBudget": {
          "oneOf": [
            { "const": "auto" },
            { "type": "integer", "minimum": 1048576, "maximum": 2147483648 }
          ]
        }
      }
    }
  }
}
