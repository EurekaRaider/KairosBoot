{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairosboot.io/schemas/fleet-job.v1.schema.json",
  "title": "KairosBoot FlashJob v1",
  "$comment": "YAML inputs use the YAML 1.2 Core Schema. Quote plain null, boolean, or number spellings when a field defined as a JSON string is intended to contain that text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "artifacts", "targets"],
  "properties": {
    "apiVersion": { "const": "kairosboot.io/v1" },
    "kind": { "const": "FlashJob" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16384,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/target" }
    },
    "policy": { "$ref": "#/$defs/policy" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "identifier": { "type": "string", "minLength": 1, "maxLength": 256 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "path": { "$ref": "#/$defs/nonEmpty" },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "serials": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "usbPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "step": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "oneOf": [
        {
          "required": ["flash"],
          "properties": {
            "flash": {
              "type": "object",
              "additionalProperties": false,
              "required": ["partition", "artifact"],
              "properties": {
                "partition": { "$ref": "#/$defs/nonEmpty" },
                "artifact": { "$ref": "#/$defs/nonEmpty" },
                "slot": { "type": "string", "enum": ["current", "other", "all", "a", "b"] }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["erase"],
          "properties": {
            "erase": {
              "type": "object",
              "additionalProperties": false,
              "required": ["partition"],
              "properties": { "partition": { "$ref": "#/$defs/nonEmpty" } }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["setActive"],
          "properties": {
            "setActive": {
              "type": "object",
              "additionalProperties": false,
              "required": ["slot"],
              "properties": { "slot": { "type": "string", "enum": ["a", "b", "other"] } }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["reboot"],
          "properties": {
            "reboot": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "target": { "type": "string", "enum": ["system", "bootloader", "recovery", "fastboot"] }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["oem"],
          "properties": {
            "oem": {
              "type": "object",
              "additionalProperties": false,
              "required": ["command"],
              "properties": { "command": { "$ref": "#/$defs/nonEmpty" } }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "selector", "expectedProduct", "steps"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "selector": { "$ref": "#/$defs/selector" },
        "expectedProduct": { "$ref": "#/$defs/nonEmpty" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16384,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onDeviceFailure": { "type": "string", "enum": ["continue", "stop"] },
        "maxParallelDevices": { "type": "integer", "minimum": 1, "maximum": 256 },
        "memoryBudget": {
          "oneOf": [
            { "const": "auto" },
            { "type": "integer", "minimum": 1048576, "maximum": 2147483648 }
          ]
        }
      }
    }
  }
}
