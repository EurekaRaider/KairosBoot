{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairosboot.io/schemas/hil-evidence.v1.schema.json",
  "title": "KairosBoot Raw Hardware HIL Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceKind", "commit", "runId", "lab", "benchmark", "soak"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceKind": { "const": "hardware" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "lab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operatorIdHash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "operatorIdHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "benchmark": { "$ref": "benchmark-result.v1.schema.json" },
    "soak": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestedDurationSeconds", "completedDurationSeconds", "startedAt", "finishedAt",
        "sampleIntervalSeconds", "cycles", "deadlocks", "transferLeaks", "handleLeaks",
        "deviceMisrouting", "sustainedRssGrowth"
      ],
      "properties": {
        "requestedDurationSeconds": { "type": "number", "minimum": 86400 },
        "completedDurationSeconds": { "type": "number", "minimum": 86400 },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "sampleIntervalSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "cycles": { "type": "integer", "minimum": 1 },
        "deadlocks": { "const": 0 },
        "transferLeaks": { "const": 0 },
        "handleLeaks": { "const": 0 },
        "deviceMisrouting": { "const": 0 },
        "sustainedRssGrowth": { "const": false }
      }
    }
  }
}
