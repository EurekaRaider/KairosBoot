{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairosboot.io/schemas/hil-evidence.v1.schema.json",
  "title": "KairosBoot HIL Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "commit", "deviceCount", "soakHours",
    "singleDeviceDownloadCeilingUtilization",
    "minimumJainFairness", "batchMakespanSpeedup", "controllers", "scenarios",
    "deadlocks", "transferLeaks", "handleLeaks", "deviceMisrouting",
    "sustainedRssGrowth"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "deviceCount": { "type": "integer", "minimum": 32 },
    "soakHours": { "type": "number", "minimum": 24 },
    "singleDeviceDownloadCeilingUtilization": {
      "type": "number",
      "minimum": 0.9,
      "maximum": 1.1
    },
    "minimumJainFairness": { "type": "number", "minimum": 0.95, "maximum": 1 },
    "batchMakespanSpeedup": { "type": "number", "minimum": 1.1 },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "weight", "fastbootCeilingUtilization", "relativeDelta",
          "statisticallySignificant"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "exclusiveMinimum": 0 },
          "fastbootCeilingUtilization": { "type": "number", "minimum": 0, "maximum": 1.1 },
          "relativeDelta": { "type": "number", "exclusiveMinimum": -1 },
          "statisticallySignificant": { "type": "boolean" }
        }
      }
    },
    "controllers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ceilingUtilization"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "ceilingUtilization": { "type": "number", "minimum": 0.9, "maximum": 1.1 }
        }
      }
    },
    "deadlocks": { "const": 0 },
    "transferLeaks": { "const": 0 },
    "handleLeaks": { "const": 0 },
    "deviceMisrouting": { "const": 0 },
    "sustainedRssGrowth": { "const": false }
  }
}
