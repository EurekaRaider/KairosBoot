  "schemaVersion": 1,
  "uncoveredScenarios": [
    {
      "coverageIds": [
        "command.fetch"
      ],
      "id": "official-scripted-fetch-chunking",
      "reason": "official Fastboot probes has-slot and max-fetch-size and performs ranged chunked fetches, while the current no-range KairosBoot CLI sends one direct fetch:partition receive command"
    },
    {
      "coverageIds": [
        "command.reboot-fastboot"
      ],
      "id": "official-scripted-reboot-fastboot",
      "reason": "official Fastboot reconnects after reboot-fastboot and verifies getvar:is-userspace, while the current KairosBoot reboot API retires the session after the terminal response"
    },
    {
      "coverageIds": [
        "command.erase"
      ],
      "id": "official-scripted-erase",
      "reason": "official Fastboot probes has-slot and partition-type before erase while KairosBoot sends the protocol command directly, so strict wire order differs"
    },
    {
      "coverageIds": [
        "command.set-active",
        "option.slot",
        "option.set-active",
        "capability.a-b-slots"
      ],
      "id": "official-scripted-slot-policy",
      "reason": "official Fastboot probes slot-count before the operation while KairosBoot uses a different getvar sequence, so the strict wire event order differs"
    },
    {
      "coverageIds": [
        "option.disable-verity",
        "option.disable-verification",
        "capability.vbmeta-avb-mutation"
      ],
      "id": "official-scripted-avb-flags",
      "reason": "the mutated DATA hash matches in a real capture, but official Fastboot performs additional is-logical and partition-size probes; strict wire event parity therefore does not pass"
    },
    {
      "coverageIds": [
        "option.sparse-limit",
        "capability.android-sparse"
      ],
      "id": "official-scripted-sparse-limit",
      "reason": "official Fastboot performs additional partition probes before sparse download, so the strict normalized wire event sequence differs"
    },
    {
      "coverageIds": [
        "command.format",
        "option.fs-options"
      ],
      "id": "official-scripted-format",
      "reason": "format delegates filesystem construction to platform mkfs tools; their filesystem bytes are not deterministic across hosted platforms"
    },
    {
      "coverageIds": [
        "command.wipe-super",
        "capability.dynamic-partitions"
      ],
      "id": "official-scripted-wipe-super",
      "reason": "wipe-super requires a valid device-specific liblp metadata image and fastbootd state that the transport-only scripted device cannot infer"
    },
    {
      "coverageIds": [
        "command.update",
        "command.flashall",
        "capability.update-zip"
      ],
      "id": "official-scripted-update-flashall",
      "reason": "update and flashall may reboot between bootloader and fastbootd and reopen the device; the single-session TCP/UDP scripted transport cannot model that lifecycle without turning the device plan into a fixture oracle"
    },
    {
      "coverageIds": [
        "command.resize-logical-partition"
      ],
      "id": "official-scripted-resize-logical-partition",
      "reason": "official Fastboot fetches and parses device-specific super metadata before resizing; a transport-only scripted device cannot synthesize that metadata without becoming a fixture oracle"
    }
  ]
}
