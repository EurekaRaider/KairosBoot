{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairosboot.io/schemas/official-fastboot-differential-evidence-v1.json",
  "title": "KairosBoot official Fastboot differential evidence",
  "type": "object",
  "required": [
    "documentType",
    "schemaVersion",
    "result",
    "baseline",
    "aospFastboot",
    "kairosboot",
    "captureFiles",
    "scenarios",
    "uncoveredScenarios"
  ],
  "additionalProperties": false,
  "properties": {
    "documentType": {
      "const": "kairosboot.official-fastboot-differential-evidence"
    },
    "schemaVersion": {"const": 1},
    "result": {"const": "matched"},
    "baseline": {
      "type": "object",
      "required": ["platformToolsVersion", "sourceCommit"],
      "additionalProperties": false,
      "properties": {
        "platformToolsVersion": {"const": "37.0.1"},
        "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "aospFastboot": {
      "type": "object",
      "required": ["platform", "sha256", "versionOutput"],
      "additionalProperties": false,
      "properties": {
        "platform": {"enum": ["darwin", "linux", "windows"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "versionOutput": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "kairosboot": {
      "type": "object",
      "required": ["releaseArtifactSha256", "sha256", "sourceCommit"],
      "additionalProperties": false,
      "properties": {
        "releaseArtifactSha256": {"$ref": "#/$defs/sha256"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "captureFiles": {
      "type": "object",
      "required": ["aosp", "kairosboot"],
      "additionalProperties": false,
      "properties": {
        "aosp": {"$ref": "#/$defs/captureFile"},
        "kairosboot": {"$ref": "#/$defs/captureFile"}
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/scenario"}
    },
    "uncoveredScenarios": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/uncoveredScenario"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coverageId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "captureFile": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 256},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "scenario": {
      "type": "object",
      "required": ["id", "transport", "coverageIds", "result"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/coverageId"},
        "transport": {"enum": ["tcp", "udp"]},
        "coverageIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/coverageId"}
        },
        "result": {"const": "matched"}
      }
    },
    "uncoveredScenario": {
      "type": "object",
      "required": ["id", "coverageIds", "reason"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/coverageId"},
        "coverageIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/coverageId"}
        },
        "reason": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    }
  }
}
